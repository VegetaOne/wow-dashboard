generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  battleTag   String          @unique
  region      String          @default("eu")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  favorites    Favorite[]
  preferences  UserPreference?
  talentBuilds TalentBuild[]
  talentTargets TalentTarget[]
  characterNotes CharacterNote[]
}

/// Angeheftete Notiz an einem Charakter – ein kurzer Merkzettel, abhakbar.
/// Nutzerdaten wie die Ziel-Builds: je Nutzer, Region und Charakter.
model CharacterNote {
  id        String   @id @default(cuid())
  userId    String
  region    String
  /// `{name}-{surname}`, klein
  charSlug  String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, region, charSlug])
}

/// Favorit eines Nutzers. Forever-Charaktere sind `{name}-{surname}` ohne
/// Realm und nur je Region eindeutig – darum Region und Slug.
model Favorite {
  id       String @id @default(cuid())
  userId   String
  region   String
  /// `{name}-{surname}`, klein
  charSlug String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, region, charSlug])
}

/// Gespeicherter Talentbuild. Nutzerdaten, keine API-Daten – darum eine
/// eigene Tabelle statt Snapshots. Ein Build gehört zu einer Klasse, nicht zu
/// einem Charakter, damit er sich auf mehrere anwenden lässt.
model TalentBuild {
  id        String         @id @default(cuid())
  userId    String
  /// Die Bäume kommen aus dem Namespace der Region – Builds gelten je Region
  region    String
  classId   Int
  name      String
  /// JSON: Rang je Talent-ID (`{"134384": 2}`), wie das Profil sie liefert
  ranks     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets   TalentTarget[]

  @@index([userId, region, classId])
}

/// Welcher Build für eine Talentverteilung eines Charakters gerade das Ziel
/// ist. Forever hat Dualspec: je Charakter bis zu zwei Einträge.
model TalentTarget {
  id          String      @id @default(cuid())
  userId      String
  region      String
  /// `{name}-{surname}`, klein
  charSlug    String
  /// Talentverteilung ab 1, in der Reihenfolge der API (`specialization_groups`)
  talentGroup Int
  buildId     String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  build       TalentBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([userId, region, charSlug, talentGroup])
}

model UserPreference {
  id        String  @id @default(cuid())
  userId    String  @unique
  mainChar  String?
  mainRealm String?
  mainMode  String?
  region    String  @default("eu")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Verdichteter Preisstand eines Auktionshauses.
///
/// Die Rohantwort des Auktionsendpunkts ist je Haus mehrere
/// Megabyte gross (bei vollen Servern über zehn) und enthält jedes einzelne
/// Gebot. Aufbewahrt wird darum nur, was eine Preisfrage beantwortet:
/// günstigster Sofortkaufpreis je Einheit, angebotene Menge, Zahl der Angebote.
///
/// Preise stehen in Kupfer – so liefert die API sie, und so bleiben sie ganze
/// Zahlen.
model AuctionPrice {
  id               String   @id @default(cuid())
  region           String
  /// Forever führt Häuser je Ruleset – aber jedes Ruleset liefert dieselben
  /// Häuser mit denselben Angeboten. Darum ist das Haus der Schlüssel, nicht
  /// das Ruleset; sonst stünde derselbe Preis mehrfach in der Tabelle.
  houseId          Int
  itemId           Int
  /// Günstigster Sofortkaufpreis je Einheit, in Kupfer
  minUnitPrice     Int
  /// Summe der angebotenen Stückzahl
  quantity         Int
  /// Zahl der Angebote – sagt, wie belastbar der Preis ist
  listings         Int
  fetchedAt        DateTime @default(now())

  @@unique([region, houseId, itemId])
  @@index([region, houseId])
}

/// Stand des letzten Auktions-Durchlaufs je Haus.
model AuctionRun {
  id               String   @id @default(cuid())
  region           String
  /// Über welches Ruleset das Haus zuletzt abgerufen wurde – nur Auskunft
  rulesetId        Int?
  houseId          Int
  houseName        String?
  status           String   @default("PENDING")
  /// Zahl der Angebote in der Rohantwort
  auctionCount     Int      @default(0)
  /// Zahl der unterschiedlichen Gegenstände mit Preis
  itemCount        Int      @default(0)
  /// Angebote ohne Sofortkaufpreis – die ergeben keinen Preis
  skippedCount     Int      @default(0)
  error            String?
  startedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([region, houseId])
}

/// Zwischengespeicherte Antworten der Profil-API, ein Stand pro Tag.
///
/// Der Tag steckt im Unique-Key: dadurch entsteht die Historie von selbst
/// (ein Abruf am selben Tag überschreibt, ein Abruf am nächsten legt an),
/// ohne dass jemand alte Zeilen ausdünnen muss.
///
/// Seit WoW Forever: ein Charakter ist `{name}-{surname}` ohne Realm, nur je
/// Region eindeutig. Account- und Gildendaten liegen in derselben Tabelle mit
/// `@account` bzw. `@guild:<slug>` als Slug.
model CharacterSnapshot {
  id        String   @id @default(cuid())
  region    String
  /// `{name}-{surname}`, `@account` oder `@guild:<slug>`
  charSlug  String
  /// "professions" | "collections" | "achievements" | "raids" | …
  dataset   String
  /// Tag als YYYY-MM-DD
  day       String
  /// Rohantwort der API als JSON
  payload   String
  fetchedAt DateTime @default(now())

  @@unique([region, charSlug, dataset, day])
  @@index([region, charSlug, dataset])
  @@index([dataset, day])
}

/// Konfiguration der Instanz – eine einzige Zeile.
///
/// Diese App läuft je Nutzer in einem eigenen Container; die Werte, die
/// früher in der `.env` standen, liegen deshalb hier. Ausgenommen bleibt
/// `DATABASE_URL`: ohne sie findet die App diese Tabelle gar nicht erst.
///
/// Das Client Secret liegt verschlüsselt (AES-256-GCM). Der Schlüssel
/// liegt als Datei neben der Datenbank – siehe `src/lib/secrets.ts`. Wer
/// Zugriff auf das Dateisystem hat, kommt an beides; geschützt ist damit
/// die Datenbankdatei allein, etwa in einem Backup.
model AppConfig {
  /// Immer "singleton" – es gibt genau eine Zeile
  id                    String    @id @default("singleton")

  /// Oberflächensprache: "en" | "de". Bestimmt zugleich die Locale der API.
  language              String    @default("en")
  /// eu | us | kr | tw
  region                String    @default("eu")

  bnetClientId          String?
  /// Verschlüsselt, nie im Klartext
  bnetClientSecret      String?

  /// Sitzungsschlüssel für NextAuth, beim Setup selbst erzeugt
  authSecret            String?

  /// Abrufintervall der Kaderliste in Sekunden
  pollSeconds           Int       @default(60)

  /// Optional, für den späteren Warcraft-Logs-Teil
  warcraftLogsClientId  String?
  /// Verschlüsselt
  warcraftLogsSecret    String?

  /// BattleTag des Accounts, der den Setup abgeschlossen hat
  ownerBattleTag        String?
  /// Gesetzt, sobald Stufe 2 durch ist – davor gilt der Setup als offen
  setupCompletedAt      DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
