# ============================================================
# WoW Dashboard – Konfiguration
#
# Seit dem Setup-Modus wird diese Datei fast nicht mehr gebraucht.
# Region, Sprache, Battle.net-Zugangsdaten und der Sitzungsschlüssel
# stehen in der Datenbank und werden beim ersten Aufruf der Website
# abgefragt. Ändern lassen sie sich danach unter Einstellungen.
#
# Für Docker brauchst du gar nichts davon: docker-compose.yml setzt
# DATABASE_URL selbst. Diese Datei ist nur für die Entwicklung ohne
# Container.
# ============================================================

# Wo die SQLite-Datei liegt. Prisma löst einen relativen Pfad gegen
# das Verzeichnis prisma/ auf. Daneben legt die App ihre Schlüsseldatei
# config.key ab, mit der das Client Secret verschlüsselt wird –
# beides gehört zusammen ins Backup.
DATABASE_URL="file:./dev.db"

# Optional. Ohne Angabe leitet die App die Adresse aus der Anfrage ab,
# was im Heimnetz praktisch ist: dieselbe Instanz funktioniert dann
# über localhost und über die lokale IP. Setze den Wert nur, wenn du
# die Adresse festnageln willst.
# NEXTAUTH_URL=http://localhost:3000

# Nur für den Fall, dass die Resetzeiten der Wochenübersicht einmal
# nicht mehr stimmen – siehe src/lib/reset.ts.
# WOW_RESET_WEEKDAY=3
# WOW_RESET_HOUR_UTC=4
# WOW_DAILY_RESET_HOUR_UTC=4
