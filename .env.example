# ============================================================
# WoW Dashboard – Konfiguration
# Kopiere diese Datei zu .env und fülle alle Werte aus.
# ============================================================

# URL der App (muss mit der Battle.net Redirect-URI übereinstimmen)
# Nur du: http://localhost:3000
# Kollege im Heimnetz: http://192.168.x.x:3000  (deine lokale IP)
NEXTAUTH_URL=http://localhost:3000

# Zufälliger geheimer Schlüssel für Session-Verschlüsselung
# Generieren: openssl rand -base64 32
NEXTAUTH_SECRET=HIER_GEHEIMEN_SCHLUESSEL_EINTRAGEN

# Battle.net Developer Console: https://develop.battle.net
# Redirect URI dort eintragen: ${NEXTAUTH_URL}/api/auth/callback/battlenet
BNET_CLIENT_ID=DEINE_CLIENT_ID
BNET_CLIENT_SECRET=DEIN_CLIENT_SECRET

# Region: eu | us | kr | tw
BNET_REGION=eu

# Wird automatisch vom Docker-Container gesetzt – nicht ändern
# DATABASE_URL=file:/data/wow-dashboard.db
